# LoadSetu x VahanSync — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is in .gitignore.
#
# Minimum to run locally:
#   GEMINI_API_KEY=<your key>
#   All other values have safe defaults for local dev.

# ── Service ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
SERVICE_VERSION=2.0.0

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1                        # Set to 4+ in production
RELOAD=true                      # Set to false in production

# ── Google Gemini ─────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDlkttw1Nsn7NDCZN0JcHV5lBN24ANbx6A
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=400     # 500 is enough for structured JSON; reduces cost
GEMINI_HARD_TIMEOUT_SECONDS=10  # Hard asyncio timeout per Gemini call
GEMINI_MAX_RETRIES=2             # tenacity: 2 retries = 3 total attempts max

# ── PostgreSQL + PostGIS ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_npBG79ckZOQX@ep-late-firefly-a12gzhj7-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:gQAAAAAAAU9EAAIncDEwMGU1ZjdhOGYwMDM0MzdmODVhMjFiZjg4ODg2YmRlZXAxODU4Mjg@true-piglet-85828.upstash.io:6379
REDIS_POOL_MAX_CONNECTIONS=50
# TTLs (seconds)
TRUCK_LOCATION_TTL_SECONDS=600      # 10 min — GPS freshness
LOAD_CACHE_TTL_SECONDS=300          # 5 min — load listing cache
USER_LANGUAGE_CACHE_TTL_SECONDS=86400  # 24h — remember driver's language
SHIPPER_STATE_TTL_SECONDS=300          # 5 min — strict shipper confirmation window
PROCESSED_MSG_TTL_SECONDS=300          # 5 min — Twilio idempotency dedup window

# ── Apache Kafka ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=vahansync-ai-service
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT   # Use SASL_SSL in production (AWS MSK)
# Uncomment for MSK / Confluent Cloud:
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=your_kafka_username
# KAFKA_SASL_PASSWORD=your_kafka_password

# ── Kafka Topics (change only if your Spring Boot team uses different names) ─
TOPIC_TRUCK_TELEMETRY=truck-telemetry-events
TOPIC_BOOKING_EVENTS=booking-events
TOPIC_LOAD_STATUS=load-status-events
TOPIC_WHATSAPP_INBOUND=whatsapp-inbound-events

# ── WhatsApp / Twilio ─────────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here          # Required for signature validation & voice download
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886    # Your Twilio WhatsApp number

# Message security
WHATSAPP_MAX_MESSAGE_LENGTH=250   # Pre-LLM injection guard (chars)

# Rate limiting — Denial-of-Wallet protection
WHATSAPP_RATE_LIMIT_MAX_REQUESTS=10    # Max requests per window per phone
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=60  # Rolling window in seconds

# Voice note security
VOICE_NOTE_MAX_BYTES=2097152           # 2MB hard cap (2 * 1024 * 1024)
VOICE_NOTE_DOWNLOAD_TIMEOUT_SECONDS=5.0

# ── Meta WhatsApp Business API ────────────────────────────────────────────
# Get from: https://developers.facebook.com/apps
META_WHATSAPP_TOKEN=your_meta_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WEBHOOK_VERIFY_TOKEN=loadsetu_verify_2025  # Any secret string you set in Meta console

# ── Spring Boot Backend ───────────────────────────────────────────────────
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_TIMEOUT_SECONDS=8.0
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST match the value in your Spring Boot application.properties
INTERNAL_API_SECRET=CHANGE_ME_BEFORE_DEPLOYING

# ── Payment Gateways ──────────────────────────────────────────────────────
# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cashfree (alternative) — https://merchant.cashfree.com/merchants/login
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# ── Pricing Engine ────────────────────────────────────────────────────────
BASE_RATE_PER_TON_KM=1.85         # INR per ton per km (India NH market rate)
FUEL_SURCHARGE_PERCENT=0.12       # 12% of base freight
PLATFORM_FEE_PERCENT=0.04         # 4% of gross — LoadSetu's revenue
DEADHEAD_PENALTY_PER_KM=8.50      # INR per empty km driven to pickup
URGENCY_PREMIUM_PERCENT=0.08      # 8% uplift for same-day loads
TOLL_RATE_PER_100KM=120.0         # Average NH toll estimate

# ── Matching Engine ───────────────────────────────────────────────────────
H3_RESOLUTION=7                   # ~5.16km per hex cell — city-level precision
H3_SEARCH_RINGS=3                 # 3 rings ≈ 50km search radius at res 7
MAX_DEADHEAD_KM=80.0              # Hard cut: never show loads requiring >80km empty drive
MAX_MATCHES_RETURNED=5
MIN_CONFIDENCE_SCORE=0.30
CAPACITY_TOLERANCE_PERCENT=0.10   # Allow 10% under-load (driver can take slightly lighter)
