# ── Backend URLs ──────────────────────────────────────────────────────────────
# Spring Boot microservice (VahanSync Core)
NEXT_PUBLIC_SPRING_URL=http://localhost:8080

# FastAPI AI engine (Matching + Pricing)
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# WebSocket endpoint — /ws/notifications per API spec
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/notifications

# ── Mapbox ─────────────────────────────────────────────────────────────────────
# Get your token from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbG9...

# ── Auth ───────────────────────────────────────────────────────────────────────
# JWT secret must match the Spring Boot application.yml jwt.secret
# (Only needed if you add a server-side JWT verification route)
# JWT_SECRET=your-256-bit-secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# This frontend origin MUST be whitelisted in Spring Boot CorsFilter
# Set CORS_ALLOWED_ORIGINS=http://localhost:3000 in Spring Boot .env
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature flags ──────────────────────────────────────────────────────────────
# Set to "true" to enable H3 heatmap by default on load
NEXT_PUBLIC_H3_HEATMAP_DEFAULT=true
