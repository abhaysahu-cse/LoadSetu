# ============================================================================
# VahanSync Core Engine — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is in .gitignore already.
# ============================================================================

# ── PostgreSQL (Neon Cloud in prod, docker-compose in local) ─────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vahansync_db
DB_USER=vahansync
DB_PASS=vahansync_secret

# ── Redis (Upstash in prod, docker-compose in local) ────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false       # Set true for Upstash (rediss://)

# ── Kafka (Local Docker in dev, MSK in prod) ─────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_512_BIT_BASE64_SECRET

# ── Internal AI Microservice Secret (shared with Python FastAPI) ───────────
# Generate with: openssl rand -hex 32
# Python FastAPI must send this in: X-INTERNAL-SECRET header
INTERNAL_API_SECRET=REPLACE_THIS_SECRET_IN_PRODUCTION

# ── ULIP / VAHAN Integration ─────────────────────────────────────────────────
ULIP_BASE_URL=https://ulip.dpiit.gov.in/ulip
ULIP_API_KEY=your-ulip-api-key
ULIP_MOCK=true        # Set false when ULIP live credentials arrive

# ── Payment Gateway (Razorpay) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
PAYMENT_MOCK=true     # Set false + fill keys above for live payments
