<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        MODULE 4: DISTRIBUTED TRACING LOG PATTERN.

        [%X{requestId}] is populated by CorrelationIdFilter via SLF4J MDC.
        - For Python AI service calls: requestId = the X-Request-ID they sent.
        - For browser/mobile calls: requestId = a UUID generated by CorrelationIdFilter.

        This guarantees: every single log line — including auth failures,
        Kafka publish errors, and DB errors — carries the requestId,
        enabling full end-to-end trace reconstruction.

        Format:
          2026-03-28 14:22:03.441 INFO  [vahansync-core] [http-nio-8080-exec-1] [abc123-def456] c.l.v.s.LoadService - Match result: 3 candidates
          └─ timestamp             level  app-name           thread                requestId      logger                   message
    -->

    <springProperty scope="context" name="APP_NAME"  source="spring.application.name" defaultValue="vahansync-core"/>
    <springProperty scope="context" name="LOG_LEVEL" source="logging.level.root"       defaultValue="INFO"/>

    <!-- ── CONSOLE (local dev + Docker stdout) ─────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME}] [%thread] [%X{requestId:-NO_REQUEST_ID}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── ROLLING FILE (production pod log scraping by CloudWatch/Datadog) ── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/vahansync.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/vahansync.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <!-- JSON-friendly format for log aggregators (ELK / CloudWatch) -->
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%-5level","app":"${APP_NAME}","thread":"%thread","requestId":"%X{requestId:-none}","logger":"%logger{36}","message":"%msg"}%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── SECURITY AUDIT LOG (auth failures, fraud attempts, shadow bans) ─── -->
    <appender name="SECURITY_AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/security-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/security-audit.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>  <!-- 90 days for compliance -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-NO_REQUEST_ID}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── ASYNC WRAPPER (prevents I/O from blocking request threads) ─────── -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <!-- ── LOGGER LEVELS ────────────────────────────────────────────────────── -->

    <!-- Security audit events → dedicated log file -->
    <logger name="com.loadsetu.vahansync.security"   level="INFO"  additivity="false">
        <appender-ref ref="SECURITY_AUDIT"/>
        <appender-ref ref="ASYNC_CONSOLE"/>
    </logger>
    <logger name="com.loadsetu.vahansync.service.PaymentWebhookService" level="INFO" additivity="false">
        <appender-ref ref="SECURITY_AUDIT"/>
        <appender-ref ref="ASYNC_CONSOLE"/>
    </logger>

    <!-- Application code -->
    <logger name="com.loadsetu.vahansync" level="DEBUG" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <!-- Reduce noise from frameworks -->
    <logger name="org.hibernate.SQL"                      level="WARN"/>
    <logger name="org.springframework.web"                level="INFO"/>
    <logger name="org.springframework.security"           level="INFO"/>
    <logger name="org.springframework.kafka"              level="INFO"/>
    <logger name="io.github.resilience4j"                 level="INFO"/>
    <logger name="io.lettuce"                             level="WARN"/>

    <!-- Root -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>

    <!--
        Spring profiles:
        - local/dev: console only, DEBUG level
        - prod: file + console, INFO level, JSON format for log aggregators
    -->
    <springProfile name="local,dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
